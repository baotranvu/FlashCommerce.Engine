{
    "name": "baotranvu/flashcommerce-engine",
    "type": "project",
    "description": "High-Concurrency Flash Sale & Campaign ShortLink Gateway",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/*"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "flashcommerce/identity": "@dev"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ],
        "test": "vendor/bin/phpunit",
        "test:unit": "vendor/bin/phpunit --testsuite=Identity::Unit",
        "test:chaos": "php tests/E2E/race_condition_chaos.php",
        "test:smoke": "php tests/E2E/verification_lifecycle_smoke.php",
        "test:rfc7807": "php tests/E2E/global_exception_rfc7807_test.php",
        "test:all": [
            "@test",
            "@test:chaos",
            "@test:smoke",
            "@test:rfc7807"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block": false
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "policy": {
        "advisories": {
            "block": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    }
}
