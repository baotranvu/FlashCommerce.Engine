{
    "name": "baotranvu/flashcommerce-engine",
    "type": "project",
    "description": "High-Concurrency Flash Sale & Campaign ShortLink Gateway",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/*"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "flashcommerce/identity": "@dev",
        "flashcommerce/catalog": "@dev"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/",
            "FlashCommerce\\Identity\\Database\\Seeders\\": "packages/Identity/database/seeders/",
            "FlashCommerce\\Catalog\\Database\\Seeders\\": "packages/Catalog/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "FlashCommerce\\Identity\\Tests\\": "packages/Identity/tests/",
            "FlashCommerce\\Catalog\\Tests\\": "packages/Catalog/tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ],
        "test": "vendor/bin/phpunit",
        "test:arch": "vendor/bin/phpunit --testsuite=Architecture",
        "test:unit": "vendor/bin/phpunit --testsuite=Identity::Unit",
        "test:integration": "vendor/bin/phpunit --testsuite=Identity::Integration",
        "test:e2e": "vendor/bin/phpunit --testsuite=Identity::E2E",
        "test:chaos": "vendor/bin/phpunit --testsuite=Identity::Chaos",
        "test:identity": "vendor/bin/phpunit --testsuite=Identity::Unit,Identity::Integration,Identity::E2E,Identity::Chaos",
        "test:catalog": "vendor/bin/phpunit --testsuite=Catalog::Unit,Catalog::Integration",
        "test:all": "vendor/bin/phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    }
}
