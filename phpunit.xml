<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Identity::Unit">
            <directory>packages/Identity/tests/Unit</directory>
        </testsuite>
        <testsuite name="Identity::Integration">
            <directory>packages/Identity/tests/Integration</directory>
        </testsuite>
        <testsuite name="Identity::E2E">
            <directory>packages/Identity/tests/E2E</directory>
        </testsuite>
        <testsuite name="Identity::Chaos">
            <directory>packages/Identity/tests/Chaos</directory>
        </testsuite>
        <testsuite name="System::Journeys">
            <directory>tests/E2E/Journeys</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>packages/*/src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="redis"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="flashcommerce_db"/>
        <env name="DB_HOST" value="ecom-mysql"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value="secretpassword"/>
        <env name="REDIS_HOST" value="ecom-redis"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
    </php>
</phpunit>
