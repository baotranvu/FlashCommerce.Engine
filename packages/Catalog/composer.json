{
    "name": "flashcommerce/catalog",
    "description": "High-Throughput Product Catalog & Two-Phase Inventory Module for FlashCommerce",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Bao Tran Vu",
            "email": "tranvubao.dev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "FlashCommerce\\Catalog\\": "src/",
            "FlashCommerce\\Catalog\\Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FlashCommerce\\Catalog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FlashCommerce\\Catalog\\CatalogServiceProvider"
            ]
        }
    }
}
