{
    "name": "flashcommerce/ordering",
    "description": "Two-Phase Inventory Hold & Flash Sale Ordering Module for FlashCommerce",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Bao Tran Vu",
            "email": "tranvubao.dev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "FlashCommerce\\Ordering\\": "src/",
            "FlashCommerce\\Ordering\\Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FlashCommerce\\Ordering\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FlashCommerce\\Ordering\\OrderingServiceProvider"
            ]
        }
    }
}
